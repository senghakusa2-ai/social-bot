# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Optional: Path to cookies.txt (e.g. cookies.txt) to download Instagram & Facebook Stories
COOKIES_FILE=cookies.txt

# Optional: Browser name to extract cookies from (chrome, edge, firefox, brave)
# BROWSER_COOKIES=chrome

# Optional: Max Telegram upload limit in MB (default 49.5 MB)
MAX_TELEGRAM_FILE_MB=49.5
